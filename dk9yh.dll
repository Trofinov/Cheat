
#include &lt;iostream&gt;
#include &lt;string&gt;
#include &lt;windows.h&gt;
#include &lt;wininet.h&gt;

#pragma comment(lib, "wininet.lib")

std::string GetLastErrorString() {
    DWORD error = GetLastError();
    if (error == 0) return "No error";
    
    LPSTR messageBuffer = nullptr;
    size_t size = FormatMessageA(
        FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
        NULL, error, MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
        (LPSTR)&amp;messageBuffer, 0, NULL
    );
    
    std::string message(messageBuffer, size);
    LocalFree(messageBuffer);
    return message;
}

bool CreateDirectoryRecursive(const std::string&amp; path) {
    size_t pos = 0;
    std::string dir;
    bool result = true;
    while ((pos = path.find_first_of("\\/", pos)) != std::string::npos) {
        dir = path.substr(0, pos++);
        if (!dir.empty()) {
            if (!CreateDirectoryA(dir.c_str(), NULL)) {
                DWORD err = GetLastError();
                if (err != ERROR_ALREADY_EXISTS) {
                    std::cout &lt;&lt; "Failed to create directory: " &lt;&lt; dir &lt;&lt; " - Error: " &lt;&lt; GetLastErrorString() &lt;&lt; std::endl;
                    result = false;
                }
            }
        }
    }
    if (!CreateDirectoryA(path.c_str(), NULL)) {
        DWORD err = GetLastError();
        if (err != ERROR_ALREADY_EXISTS) {
            std::cout &lt;&lt; "Failed to create directory: " &lt;&lt; path &lt;&lt; " - Error: " &lt;&lt; GetLastErrorString() &lt;&lt; std::endl;
            result = false;
        }
    }
    return result;
}

bool DownloadFile(const std::string&amp; url, const std::string&amp; filePath) {
    std::cout &lt;&lt; "Connecting to: " &lt;&lt; url &lt;&lt; std::endl;
    
    HINTERNET hInternet = InternetOpenA("CheatLoader", INTERNET_OPEN_TYPE_PRECONFIG, NULL, NULL, 0);
    if (!hInternet) {
        std::cout &lt;&lt; "InternetOpen failed: " &lt;&lt; GetLastErrorString() &lt;&lt; std::endl;
        return false;
    }

    HINTERNET hConnect = InternetOpenUrlA(hInternet, url.c_str(), NULL, 0, INTERNET_FLAG_RELOAD | INTERNET_FLAG_NO_CACHE_WRITE, 0);
    if (!hConnect) {
        std::cout &lt;&lt; "InternetOpenUrl failed: " &lt;&lt; GetLastErrorString() &lt;&lt; std::endl;
        InternetCloseHandle(hInternet);
        return false;
    }

    FILE* file = fopen(filePath.c_str(), "wb");
    if (!file) {
        std::cout &lt;&lt; "Failed to open file for writing: " &lt;&lt; filePath &lt;&lt; " - Error: " &lt;&lt; GetLastErrorString() &lt;&lt; std::endl;
        InternetCloseHandle(hConnect);
        InternetCloseHandle(hInternet);
        return false;
    }

    std::cout &lt;&lt; "Downloading..." &lt;&lt; std::endl;
    char buffer[4096];
    DWORD bytesRead;
    DWORD totalBytes = 0;
    while (InternetReadFile(hConnect, buffer, sizeof(buffer), &amp;bytesRead) &amp;&amp; bytesRead &gt; 0) {
        fwrite(buffer, 1, bytesRead, file);
        totalBytes += bytesRead;
        std::cout &lt;&lt; "\rDownloaded " &lt;&lt; totalBytes &lt;&lt; " bytes...";
    }
    std::cout &lt;&lt; std::endl;

    fclose(file);
    InternetCloseHandle(hConnect);
    InternetCloseHandle(hInternet);
    
    std::cout &lt;&lt; "Download complete! Total bytes: " &lt;&lt; totalBytes &lt;&lt; std::endl;
    return true;
}

int main() {
    const char key = 0x42;
    const unsigned char encryptedPassword[] = { 0x24, 0x30, 0x23, 0x25, 0x24, 0x23, 0x37, 0x2E, 0x36 };
    const size_t passwordLength = sizeof(encryptedPassword) / sizeof(encryptedPassword[0]);
    
    std::string decryptedPassword;
    for (size_t i = 0; i &lt; passwordLength; ++i) {
        decryptedPassword += static_cast&lt;char&gt;(encryptedPassword[i] ^ key);
    }
    
    std::cout &lt;&lt; "Enter Key!" &lt;&lt; std::endl;
    
    std::string userInput;
    std::getline(std::cin, userInput);
    
    std::cout &lt;&lt; "You entered: " &lt;&lt; userInput &lt;&lt; std::endl;
    
    if (userInput == decryptedPassword) {
        std::cout &lt;&lt; "Success!" &lt;&lt; std::endl;
        
        std::string dirPath = "C:\\Cheat Loader";
        std::string filePath = "C:\\Cheat Loader\\Dk8sd.dll";
        
        std::cout &lt;&lt; "Creating directory: " &lt;&lt; dirPath &lt;&lt; std::endl;
        if (CreateDirectoryRecursive(dirPath)) {
            std::cout &lt;&lt; "Directory created or already exists!" &lt;&lt; std::endl;
            // Замените URL на реальный адрес скачивания DLL
            std::string dllUrl = "https://example.com/Dk8sd.dll";
            if (DownloadFile(dllUrl, filePath)) {
                std::cout &lt;&lt; "DLL downloaded successfully!" &lt;&lt; std::endl;
            } else {
                std::cout &lt;&lt; "Failed to download DLL!" &lt;&lt; std::endl;
            }
        } else {
            std::cout &lt;&lt; "Failed to create directory!" &lt;&lt; std::endl;
        }
    } else {
        std::cout &lt;&lt; "Wrong password!" &lt;&lt; std::endl;
    }
    
    std::cout &lt;&lt; "Press Enter to exit...";
    std::cin.get();
    
    return 0;
}

